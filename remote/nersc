#: Keys whose unusable value has been reported, so each is said once a run.
_REPORTED = set()


def cfg_number(key):
    """A number of 0 or more from the config, or its default, saying so once
    when the configured value is not one."""
    raw = str(CFG.get(key, "")).strip()
    try:
        value = float(raw)
    except ValueError:
        value = -1.0
    if 0 <= value < float("inf"):
        return value
    if key not in _REPORTED:
        _REPORTED.add(key)
        sys.stderr.write("nersc: %s = %r in %s is not a number of 0 or more; "
                         "using %s\n" % (key, raw, CONFIG_PATH, DEFAULTS[key]))
    return float(DEFAULTS[key])


def die(message, *hints):
    sys.stderr.write("nersc: %s\n" % message)
    for hint in hints:
        sys.stderr.write("  %s\n" % hint)
    sys.exit(1)


class Terminated(BaseException):
    """SIGTERM or SIGHUP, raised wherever this process is.

    Raised rather than obeyed, so that every ``finally`` still runs, as for
    Ctrl-C: a transfer in progress is asked to stop, and a reap pass saves
    its state and lets go of its lock.  A BaseException, so that no
    ``except Exception`` on the way swallows it.
    """

    def __init__(self, signum):
        BaseException.__init__(self, signum)
        self.signum = signum
        #: The exit status a shell reports for a process this signal ended.
        self.code = 128 + signum


def _raise_terminated(signum, _frame):
    raise Terminated(signum)


def unwind_on_signals():
    """Make SIGTERM and SIGHUP raise Terminated.

    A signal this process was started ignoring stays ignored: under nohup,
    SIGHUP is meant to change nothing.
    """
    for signum in (signal.SIGTERM, signal.SIGHUP):
        try:
            if signal.getsignal(signum) != signal.SIG_IGN:
                signal.signal(signum, _raise_terminated)
        except (OSError, ValueError):
            pass


def _signal_name(stop):
    """"SIGTERM" for a Terminated, "Ctrl-C" for a KeyboardInterrupt."""
    if isinstance(stop, Terminated):
        try:
            return signal.Signals(stop.signum).name
        except ValueError:
            return "signal %d" % stop.signum
    return "Ctrl-C"


