def parse_scontrol(text):
    """`scontrol show job` output -> {key: value} (first win per key)."""
    info = {}
    for token in text.split():
        if "=" in token:
            key, _, value = token.partition("=")
            info.setdefault(key, value)
    return info


def _job_workdir(job):
    """(state, workdir, stdout_path, extra) for a job, however old it is.

    scontrol knows running/recent jobs (and the expanded StdOut path); sacct
    covers everything after that; the return queue is the last resort for a
    tracked job whose accounting is unreachable.
    """
    # For an array parent, scontrol can report the base record completed while
    # one child is still running.  The aggregate sacct state is authoritative
    # for monitoring and cleanup decisions.
    aggregate_state = _job_states([job], strict=False).get(job)
    code, out = remote_out(["scontrol", "show", "job", job])
    if code == 0 and "WorkDir=" in out:
        info = parse_scontrol(out)
        extra = "runtime %s/%s on %s" % (info.get("RunTime", "?"),
                                         info.get("TimeLimit", "?"),
                                         info.get("NodeList", "?"))
        return (aggregate_state or info.get("JobState", "?"), info.get("WorkDir"),
                info.get("StdOut"), extra)
    code, out = remote_out(["sacct", "-X", "-n", "-P", "-S", SACCT_START, "-j", job,
                            "--format=State,Elapsed,WorkDir"])
    if code == 0 and out.strip():
        state, elapsed, workdir = (out.strip().splitlines()[0].split("|") + ["", ""])[:3]
        if workdir:
            return state, workdir, None, "elapsed %s" % elapsed
    for entry in _read_queue():
        if entry["job"] == job:
            return "UNKNOWN", entry["src"], None, "from the return queue"
    return None, None, None, None


def cmd_peek(rest):
    rest = list(rest)
    lines = 40
    if "-n" in rest:
        idx = rest.index("-n")
        if idx + 1 >= len(rest):
            die("-n needs a line count")
        lines = _whole_number(rest[idx + 1], "-n")
        del rest[idx:idx + 2]
    if not rest:
        die("usage: nersc peek JOBID [FILE] [-n LINES]")
    job = rest[0]
    if not JOB_ID_RE.match(job):
        die("'%s' does not look like a Slurm job id" % job)
    file_arg = rest[1] if len(rest) > 1 else None

    state, workdir, stdout_path, extra = _job_workdir(job)
    if workdir is None:
        die("job %s is unknown to scontrol, sacct and the return queue" % job)
    print("job %s: %s (%s)" % (job, state, extra))
    print("run dir: %s" % workdir)
    sys.stdout.flush()  # the remote output below bypasses this buffer
    if state.startswith("PENDING") and not file_arg:
        print("(not started; nothing to tail yet)")
        return 0

    if file_arg:
        target = file_arg if file_arg.startswith("/") else "%s/%s" % (workdir, file_arg)
        tail_cmd = ("tail -n %d %s 2>/dev/null || echo '(file not there yet)'"
                    % (lines, shlex.quote(target)))
        label = target
    elif stdout_path:
        tail_cmd = ("tail -n %d %s 2>/dev/null || echo '(no output yet)'"
                    % (lines, shlex.quote(stdout_path)))
        label = stdout_path
    else:
        # finished job with no recorded StdOut: newest .out/.log in the run dir
        tail_cmd = ("f=$(ls -t *.out *.log 2>/dev/null | head -1); "
                    "if [ -n \"$f\" ]; then echo \"[$f]\"; tail -n %d \"$f\"; "
                    "else echo '(no .out/.log file here)'; fi" % lines)
        label = "newest .out/.log"
    banner = "----- %s (last %d lines) -----" % (label, lines)
    script = ("cd %s 2>/dev/null || { echo 'run dir is gone (returned/cleaned?)'; exit 0; }; "
              "ls -lt | head -15; echo; echo %s; %s"
              % (shlex.quote(workdir), shlex.quote(banner), tail_cmd))
    return remote_run(["bash", "-c", script])


def cmd_fetch(rest):
    rest = list(rest)
    if not rest:
        die("usage: nersc fetch JOBID [DEST]")
    job = rest[0]
    if not JOB_ID_RE.match(job):
        die("'%s' does not look like a Slurm job id" % job)
    state, workdir, _, extra = _job_workdir(job)
    if workdir is None:
        die("job %s is unknown to scontrol, sacct and the return queue" % job)
    dest = rest[1] if len(rest) > 1 else default_dest(workdir)
    if not dest:
        die("no default destination for %s" % workdir, *_no_default_dest_hints())
    print("job %s: %s (%s)" % (job, state, extra))
    print("fetching %s -> %s" % (workdir, dest))
    sys.stdout.flush()
    if not _pull_run_dir({"job": job, "src": workdir, "dest": dest,
                          "cleanup": False}, state):
        die("fetch of %s failed" % job)
    if not is_terminal(state):
        print("fetched a snapshot; the job is still %s — rerun to refresh" % state)
    else:
        print("fetched")
    return 0


