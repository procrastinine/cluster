def cert_valid_until():
    """Naive local datetime the certificate expires, or None."""
    if not cert_file().is_file():
        return None
    try:
        proc = subprocess.run(
            ["ssh-keygen", "-L", "-f", str(cert_file())],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            universal_newlines=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in proc.stdout.splitlines():
        parts = line.split()
        if "Valid:" in line and len(parts) >= 5 and parts[3] == "to":
            try:
                return datetime.strptime(parts[4], "%Y-%m-%dT%H:%M:%S")
            except ValueError:
                return None
    return None


def cert_seconds_left():
    until = cert_valid_until()
    if until is None:
        return None
    return (until - datetime.now()).total_seconds()


def describe_cert():
    left = cert_seconds_left()
    if left is None:
        if not key_path().is_file():
            return "missing"
        return "unreadable"
    if left <= 0:
        return "EXPIRED %s ago" % _ago(-left)
    return "valid for %s" % _ago(left)


def _ago(seconds):
    seconds = int(seconds)
    if seconds >= 3600:
        return "%dh%02dm" % (seconds // 3600, (seconds % 3600) // 60)
    if seconds >= 60:
        return "%dm" % (seconds // 60)
    return "%ds" % seconds


def require_cert():
    left = cert_seconds_left()
    if left is None:
        die("no NERSC certificate at %s" % cert_file(),
            "it is installed from the workstation: run `cluster bridge push` there",
            CFG["refresh_hint"])
    if left <= 0:
        die("the NERSC certificate expired %s ago" % _ago(-left),
            "nothing on this side can renew it; %s" % CFG["refresh_hint"],
            "if the workstation has been offline, run `cluster bridge push` there by hand")


