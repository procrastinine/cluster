# --------------------------------------------------------------------------
# progress policy
#
# There are no wall-clock deadlines in this tool: a pull of a huge run
# directory and a two-second `mv` may each take as long as they need.  What
# is never allowed is SILENCE.  Every remote call streams, and every remote
# call is made to emit progress (the reap deletes with `rm -rfv`, rsync runs
# with --out-format), so "nothing has arrived for a while" means the far side
# is wedged rather than busy, which is what a remote process parked in
# unrecovered Lustre I/O looks like.
#
# no_progress_seconds is therefore an INACTIVITY window, reset by every byte
# of output, never a budget for the operation.  0 disables abandonment
# (diagnostics still print), and NERSC_NO_PROGRESS_SECONDS overrides the
# configured window for one run.
PROGRESS_TICK_SECONDS = 15


def no_progress_seconds():
    raw = os.environ.get("NERSC_NO_PROGRESS_SECONDS", "")
    if raw.strip():
        try:
            return max(0.0, float(raw))
        except ValueError:
            sys.stderr.write("nersc: ignoring unparsable "
                             "NERSC_NO_PROGRESS_SECONDS=%r\n" % raw)
    return cfg_number("no_progress_seconds")


def rsync_stall_flag():
    """rsync's own I/O-inactivity guard, from the same policy.

    rsync --timeout is not a wall clock either: it fires only when no data
    has moved for that long, so a slow-but-live transfer is never cut off.
    0 means "no timeout" to rsync, matching the disable switch.
    """
    return "--timeout=%d" % int(no_progress_seconds())


