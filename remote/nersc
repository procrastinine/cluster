def cmd_status(args):
    quick = "--quick" in args
    print("nersc tool %s on %s" % (VERSION, os.uname()[1].split(".")[0]))
    print("certificate: %s" % describe_cert())
    print("connection: %s" % ("up" if master_alive() else "down (opens on demand)"))
    if quick:
        return 0
    left = cert_seconds_left()
    if left is None or left <= 0:
        return 1
    code, out = remote_out(["squeue", "--me", "-h", "-o", "%T"])
    if code == 0:
        states = out.split()
        summary = {}
        for state in states:
            summary[state] = summary.get(state, 0) + 1
        pretty = ", ".join("%d %s" % (n, s.lower()) for s, n in sorted(summary.items()))
        print("jobs: %s" % (pretty or "none queued"))
    else:
        print("jobs: (squeue failed, rc=%d)" % code)
    stamp = STATE_DIR / "last-sync"
    if not mirror_src():
        print("mirror: not configured")
    elif stamp.is_file():
        try:
            age = time.time() - int(stamp.read_text().strip() or 0)
        except (OSError, ValueError):
            print("mirror: sync time unreadable (%s)" % stamp)
        else:
            print("mirror: synced %s ago" % _ago(age))
    else:
        print("mirror: never synced from this account")
    return 0


def cmd_config(args):
    """Print the effective configuration: every key, where its value came
    from, and any key in the file that this tool does not know."""
    if args:
        die("usage: nersc config")
    in_file = _config_file_values()
    if CONFIG_PATH.is_file():
        print("config: %s" % CONFIG_PATH)
    else:
        print("config: %s (absent: every value is a default)" % CONFIG_PATH)
    for key in DEFAULTS:
        value = CFG.get(key, "")
        origin = "" if key in in_file else "  (default)"
        print("  %s = %s%s" % (key, value, origin))
    for key in sorted(set(in_file) - set(DEFAULTS)):
        print("  %s = %s  (not a setting this tool reads)" % (key, in_file[key]))
    return 0


ENV_SNAPSHOT_SNIPPET = (
    "import json, re\n"
    "from importlib.metadata import distributions\n"
    "packages = {}\n"
    "for dist in distributions():\n"
    "    name = dist.metadata.get('Name')\n"
    "    if not name:\n"
    "        continue\n"
    "    key = re.sub(r'[-_.]+', '-', name).lower()\n"
    "    packages[key] = dist.version\n"
    "print(json.dumps(packages, sort_keys=True))\n"
)
#: Distributions NERSC adds to Python environments on Perlmutter itself (its
#: usage monitoring), so their presence there alone is not drift.
NERSC_SITE_ONLY_PACKAGES = ("nersc-pymon",)


def _some(names, shown=3):
    """The first *shown* of *names*, then how many more there are."""
    text = ", ".join(names[:shown])
    if len(names) > shown:
        text += " and %d more" % (len(names) - shown)
    return text


def check_env_parity():
    """Compare the two live venvs using distribution metadata only."""
    src = mirror_src().rstrip("/")
    if not src or not (CFG.get("mirror_dest") or "").strip():
        return "no code mirror configured", "not checked"
    local_python = os.path.join(src, ".venv", "bin", "python")
    if not os.path.exists(local_python):
        return (
            "no venv at %s"
            % os.path.dirname(os.path.dirname(local_python)),
            "not checked",
        )
    try:
        proc = subprocess.run(
            [local_python, "-c", ENV_SNAPSHOT_SNIPPET],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            universal_newlines=True,
            timeout=60,
        )
        local_packages = (
            json.loads(proc.stdout) if proc.returncode == 0 else None
        )
    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
        return "check failed (%s)" % exc, "not checked"
    if not isinstance(local_packages, dict):
        return (
            "metadata snapshot failed (rc=%d)" % proc.returncode,
            "not checked",
        )
    dest = expand_remote(CFG["mirror_dest"].strip()).rstrip("/")
    code, out = remote_out(
        ["%s/.venv/bin/python" % dest, "-c", ENV_SNAPSHOT_SNIPPET],
    )
    local = "OK (%d installed distributions)" % len(local_packages)
    if code != 0:
        return local, "NERSC venv metadata check failed (rc=%d)" % code
    try:
        remote_packages = json.loads(out)
    except ValueError:
        return local, "NERSC venv returned malformed metadata"
    if not isinstance(remote_packages, dict):
        return local, "NERSC venv returned non-object metadata"
    ignored = set(NERSC_SITE_ONLY_PACKAGES)
    missing = sorted(set(local_packages) - set(remote_packages))
    extra = sorted(set(remote_packages) - set(local_packages) - ignored)
    drift = sorted(
        name
        for name in set(local_packages) & set(remote_packages)
        if local_packages[name] != remote_packages[name]
    )
    if missing or extra or drift:
        details = []
        if missing:
            details.append("missing: %s" % _some(missing))
        if extra:
            details.append("extra: %s" % _some(extra))
        if drift:
            details.append("version drift: %s" % _some([
                "%s %s/%s" % (name, local_packages[name], remote_packages[name])
                for name in drift
            ]))
        remote = "DRIFT (%s)" % "; ".join(details)
    else:
        site_only = len(set(remote_packages) & ignored)
        remote = "OK (%d matched%s)" % (
            len(local_packages),
            "; %d NERSC-only ignored" % site_only if site_only else "",
        )
    return local, remote


def env_parity_enabled():
    """Whether live distribution parity should be checked by doctor."""
    mode = CFG.get("env_parity", "auto").strip().lower()
    if mode not in ("auto", "on", "off"):
        sys.stderr.write(
            "nersc: invalid env_parity=%r in %s; expected auto, on or off; "
            "using auto\n" % (CFG.get("env_parity"), CONFIG_PATH)
        )
        mode = "auto"
    if mode == "off":
        return False
    if mode == "on":
        return True
    src = mirror_src().rstrip("/")
    return bool(src) and os.path.isfile(os.path.join(src, ".venv", "bin", "python"))


def cmd_doctor(args):
    problems = 0
    print("nersc tool %s" % VERSION)
    left = cert_seconds_left()
    print("certificate: %s (%s)" % (describe_cert(), cert_file()))
    if left is None or left <= 0:
        print("  -> %s" % CFG["refresh_hint"])
        problems += 1
    print("pool %s:22: %s" % (CFG["pool"], "reachable" if _tcp_ok(CFG["pool"]) else "UNREACHABLE"))
    for host in CFG["dtns"].split():
        print("dtn %s:22: %s" % (host, "reachable" if _tcp_ok(host) else "unreachable"))
    if left and left > 0:
        ensure_master(quiet=False)
        started = time.time()
        code, out = remote_out(["hostname"])
        if code == 0:
            print("round trip: %s in %.1fs" % (out.strip(), time.time() - started))
        else:
            print("round trip FAILED (rc=%d)" % code)
            problems += 1
        code, out = remote_out(["bash", "-lc", "echo scratch=$PSCRATCH"])
        if code == 0:
            print("remote %s" % out.strip().splitlines()[-1])
        if env_parity_enabled():
            local_env, remote_env = check_env_parity()
            print("env parity (live installed-distribution metadata):")
            print("  local venv: %s" % local_env)
            print("  nersc venv: %s" % remote_env)
            if "OK" not in local_env or "OK" not in remote_env:
                print("  -> align the local/NERSC venv package sets, then rerun doctor")
                problems += 1
        elif CFG.get("env_parity", "auto").strip().lower() == "off":
            print("env parity: off")
        else:
            print("env parity: skipped (local mirror venv is absent; "
                  "set env_parity = on to require it)")
    print("config: %s" % (CONFIG_PATH if CONFIG_PATH.is_file() else "defaults (no config file)"))
    if mirror_src():
        print("mirror: %s -> ~/%s" % (mirror_src(), CFG.get("mirror_dest", "").strip()))
        print("mirror excludes: %s" % (EXCLUDE_PATH if EXCLUDE_PATH.is_file() else "MISSING"))
    else:
        print("mirror: not configured (sync and the syncing submit are off)")
    print("return root: %s" % (return_root() or "not configured (returns need an explicit DEST)"))
    line, bad = describe_hooks()
    print(line)
    problems += bad
    return 1 if problems else 0


def describe_hooks():
    """(one doctor line, 1 if the hooks file is broken else 0)."""
    if not (CFG.get("hooks") or "").strip():
        return "hooks: none", 0
    if HOOKS_ERROR:
        return ("hooks: %s FAILED TO LOAD (%s)\n  -> the default submit form is "
                "refused until it loads" % (CFG["hooks"], HOOKS_ERROR)), 1
    provided = [name for name in ("submit_argv", "submit_inputs",
                                  "SUBMIT_INPUT_EXCLUDES", "return_excludes")
                if getattr(HOOKS, name, None) is not None]
    return "hooks: %s (%s)" % (CFG["hooks"], ", ".join(provided) or "defines nothing"), 0


# --------------------------------------------------------------------------
# dispatch
# --------------------------------------------------------------------------

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--version":
        print(VERSION)
        return 0
    verb, rest = argv[0], argv[1:]

    if verb == "sbatch":
        return cmd_sbatch(rest)
    if verb == "track":
        return cmd_track(rest)
    if verb == "reap":
        return cmd_reap(rest)
    if verb == "peek":
        return cmd_peek(rest)
    if verb == "fetch":
        return cmd_fetch(rest)
    if verb in SLURM_VERBS:
        if verb == "squeue" and not rest:
            rest = ["--me"]
        return remote_run([verb] + rest)
    if verb in ("q", "jobs"):
        return remote_run(["squeue", "--me", "-o",
                           "%.10i %.16j %.10P %.8T %.10M %.10l %R"] + rest)
    if verb == "run":
        cd = None
        if rest[:1] == ["--cd"]:
            if len(rest) < 2:
                die("--cd needs a directory")
            cd = expand_remote(rest[1])
            rest = rest[2:]
        if rest[:1] == ["--"]:
            rest = rest[1:]
        if not rest:
            die("nothing to run", "usage: nersc run [--cd DIR] [--] CMD ...")
        return remote_run(rest, cd=cd)
    if verb == "sh":
        if not rest:
            die("usage: nersc sh 'SHELL LINE'")
        return remote_run(["bash", "-lc", " ".join(rest)])
    if verb == "shell":
        ensure_master(quiet=False)
        return subprocess.run(mux_ssh(extra=("-t",), batch=False)).returncode
    if verb == "push":
        return rsync_transfer(rest, up=True)
    if verb == "pull":
        return rsync_transfer(rest, up=False)
    if verb == "sync":
        return cmd_sync(rest)
    if verb == "submit":
        return cmd_submit(rest)
    if verb == "cert":
        print("certificate: %s (%s)" % (describe_cert(), cert_file()))
        return 0 if (cert_seconds_left() or 0) > 0 else 1
    if verb == "status":
        return cmd_status(rest)
    if verb == "config":
        return cmd_config(rest)
    if verb == "doctor":
        return cmd_doctor(rest)
    if verb == "connect":
        ensure_master(quiet=False)
        print("connection up")
        return 0
    if verb == "disconnect":
        if master_alive():
            subprocess.run(["ssh", "-F", "/dev/null", "-o", "ControlPath=%s" % sock_path(),
                            "-O", "exit", "dummy"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print("connection closed")
        else:
            print("no connection open")
        return 0

    die("unknown verb '%s'" % verb, "run `nersc --help` for the verb list")


def _entry(argv):
    """main(), ended by a signal or Ctrl-C the way a shell expects."""
    unwind_on_signals()
    try:
        return main(argv)
    except (KeyboardInterrupt, Terminated) as stop:
        sys.stderr.write("nersc: stopped by %s\n" % _signal_name(stop))
        return stop.code if isinstance(stop, Terminated) else 130


if __name__ == "__main__":
    sys.exit(_entry(sys.argv[1:]))
