# project hooks
#
# A hooks file is ordinary Python (3.6-compatible, stdlib only) named by
# `hooks = PATH` in the config.  Everything in it is optional:
#
#   submit_argv(args, tool) -> list | None
#       Rewrite the default (non `--`) `nersc submit ARGS` form into the
#       remote command -- a venv launcher, injected flags.  None means ARGS
#       run verbatim.
#   submit_inputs(argv, tool) -> [local paths]
#       Inputs the rewritten command needs on NERSC; each is staged to its
#       parity path (return_root <-> scratch, mirror_src <-> mirror_dest).
#   SUBMIT_INPUT_EXCLUDES = (rsync patterns, ...)
#       Applied when a staged input is a whole directory.
#   return_excludes(tool) -> [rsync patterns]
#       Excluded from every job return (reap, fetch).
#
# `tool` is a live view of this module: tool.CFG, tool.die(message, *hints),
# tool.expand_remote(path), and so on.
# --------------------------------------------------------------------------

class _Tool(object):
    """What a hooks file sees as ``tool``: this module's globals, read at the
    moment of use, so a replaced CFG is the one a hook sees."""

    def __getattr__(self, name):
        try:
            return globals()[name]
        except KeyError:
            raise AttributeError(name)


TOOL = _Tool()


def load_hooks():
    """(module or None, error text or None) for the configured hooks file."""
    path = _configured_path("hooks")
    if not path:
        return None, None
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("nersc_project_hooks", path)
        if spec is None or spec.loader is None:
            raise ImportError("not a Python source file")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except Exception as exc:  # a broken hooks file must not break the tool
        return None, "%s: %s" % (type(exc).__name__, exc)
    return module, None


