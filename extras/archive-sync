#!/usr/bin/env bash
# archive-sync — mirror a cluster home into an rclone remote (typically an
# encrypted crypt remote), over a connection owned by the `cluster` tool.
#
# This is an OPTIONAL extra. Nothing in `cluster` calls it or needs it, and it
# does nothing until it is configured: see extras/README.md for setting up a
# remote and the config file. All it needs from the core tool is
# `cluster ssh-command` (the transport) and `cluster channels --free`
# (concurrency sizing).
#
# Usage:
#   archive-sync [--backend NAME] [--login NAME] [--dry-run|-n] [--fence-only]
#                [RCLONE-FLAG ...]
#   archive-sync [--backend NAME] --show-config
#   archive-sync --list-backends
#
#   --backend NAME   the cluster home to mirror (default: first of BACKENDS)
#   --login NAME     ride this login's master (selects the login transport)
#   --dry-run, -n    report what would change, change nothing
#   --fence-only     regenerate the symlink fence, then stop (no rclone)
#   --show-config    print the effective settings, then stop (touches nothing)
#   --list-backends  print the backends archive-sync-cron mirrors, then stop
#   Any other flag is passed to rclone.
#
# Exit status:
#   0  done
#   1  this run failed (the connection, the symlink scan or rclone); a later
#      run may succeed
#   2  a configuration or usage error: retrying will not help
#   3  not configured
#   4  another archive-sync for this backend is running
#
# Files (XDG_CONFIG_HOME and XDG_STATE_HOME move them; an empty or relative
# value counts as unset):
#   ~/.config/cluster/archive-sync.conf               the settings
#   ~/.config/cluster/archive/<backend>-home.filter   a backend's own filter;
#       without one, home.filter from beside this script is used
#   ~/.local/state/cluster/archive-sync/              logs, fences, stamps, locks
#
# Each backend's home goes to its own destination (default <REMOTE><backend>-home).
# Everything that differs between backends is a setting; the sync itself is
# one code path.
#
# Transport: rclone sftp over a connection owned by the `cluster` tool, obtained
# with `cluster ssh-command`. That command brings the connection up if it is
# down (re-authenticating if needed) and prints an ssh command line, so nothing
# here needs to know about control masters, TOTP, jump hosts or certificates.
#   * TRANSPORT=login (the default) rides a login's master. Right where login
#     nodes serve storage as well as shells and an extra connection costs a
#     credential (on FASRC, a TOTP window).
#   * TRANSPORT=transfer (the default for nersc) uses a dedicated transfer
#     connection on a data transfer node. NERSC login nodes are cgroup-capped
#     and reserved by policy for editing and compiling, while DTNs are built
#     for I/O and are routable directly.
#
# A shared master can be up yet useless — its channels spent, or its node
# refusing per-user exec while still passing the balancer's health check. Rather
# than skip the day's archive, the run then opens a login of its own (default
# name `archive-<backend>`, FALLBACK_LOGIN) and, if that node is bad too, moves
# it once; a login it opened is closed again on the way out.
#
# What is excluded:
#   * static rules: the backend's filter file (envs, caches, build trees, ...)
#   * symlinks whose targets resolve outside the cluster home. rclone's sftp
#     backend follows symlinks, both file and directory, so an unfenced link
#     into scratch or project space would pull tens of gigabytes into the
#     archive. Generated into <state>/<backend>-symlink-fence.filter.
#   * directories holding a .nosync marker; those rules are generated by the
#     same scan and written into the generated filter.
#
# Deletions and overwrites are not destructive: --backup-dir moves the old
# object to <dest>-trash/<timestamp>/ instead of dropping it. The trash is
# deliberately never pruned.
#
# --fast-list is what makes this fast on storage that advertises ListR (crypt
# passes it through from the remote beneath it): the destination is listed in
# one recursive call (~6s for 45k objects) instead of a per-directory walk
# throttled to --checkers (15+ minutes). It is safe here because --backup-dir
# points at a sibling path, not inside the synced tree.
# --exclude-if-present must NEVER be combined with it: the marker probing
# defeats ListR and, under --fast-list, stalls the whole run inside the up-front
# tree build (observed: "Checks: 0/0" for an hour). .nosync is therefore
# handled by the scan below.
#
# Concurrency: rclone takes one sftp connection per running transfer, one per
# checker, and one for its hash/mkdir shell commands, so the pool must be at
# least transfers + checkers + 1 — and sshd allows only about ten channels per
# connection. --multi-thread-streams must stay at 1, or a single large file
# quietly takes several connections while holding its transfer slot.
set -euo pipefail

die() { echo "archive-sync: $*" >&2; exit 2; }   # retrying will not help
fail() { echo "archive-sync: $*" >&2; exit 1; }  # a later run may succeed

BACKEND=""
LOGIN=""
FENCE_ONLY=0
DRY_RUN=0
MODE=sync
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --backend) [ $# -ge 2 ] || die "--backend needs a name"; BACKEND="$2"; shift ;;
        --backend=*) BACKEND="${1#--backend=}" ;;
        --login) [ $# -ge 2 ] || die "--login needs a name"; LOGIN="$2"; shift ;;
        --login=*) LOGIN="${1#--login=}" ;;
        --dry-run|-n|--dry-run=true) DRY_RUN=1; ARGS+=(--dry-run) ;;
        --fence-only) FENCE_ONLY=1 ;;
        --show-config) MODE=show ;;
        --list-backends) MODE=list ;;
        # Unrecognised flags go to rclone, which is the point — but -h/--help
        # must never fall into that bucket: asking for help would start a real
        # sync, because rclone ignores what it does not know here.
        -h|--help)
            # The whole header comment, up to the first line that is not a
            # comment, so the help is always all of it.
            sed -n '2,/^[^#]/p' "$0" | sed '$d;s/^# \{0,1\}//'
            exit 0
            ;;
        *) ARGS+=("$1") ;;
    esac
    shift
done

# ---- where things live ------------------------------------------------------
# xdg_dir VAR DEFAULT: the XDG base directory VAR names, or DEFAULT when VAR is
# unset, empty or relative (the XDG spec says to ignore a relative one).
xdg_dir() {
    local value="${!1-}"
    case "$value" in
        /*) printf '%s' "$value" ;;
        *) printf '%s' "$2" ;;
    esac
}
CONFIG_DIR="$(xdg_dir XDG_CONFIG_HOME "$HOME/.config")/cluster"
STATE_DIR="$(xdg_dir XDG_STATE_HOME "$HOME/.local/state")/cluster/archive-sync"
CONFIG="${ARCHIVE_SYNC_CONFIG:-$CONFIG_DIR/archive-sync.conf}"

# This script's directory, through any symlinks to it (~/.local/bin/archive-sync
# -> the checkout's extras/): the default filter is shipped beside it.
script_dir() {
    local path="$1" dir target
    while [ -L "$path" ]; do
        dir="$(CDPATH='' cd -P "$(dirname "$path")" && pwd)"
        target="$(readlink "$path")"
        case "$target" in
            /*) path="$target" ;;
            *) path="$dir/$target" ;;
        esac
    done
    CDPATH='' cd -P "$(dirname "$path")" && pwd
}
SHIPPED_FILTER="$(script_dir "$0")/home.filter"

# A path as the user would type it.
tilde() {
    # shellcheck disable=SC2088  # a literal ~, for display
    case "$1" in
        "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# ---- configuration ----------------------------------------------------------
# The config file is PARSED, never sourced: it is read by a nightly job, and a
# stray `$(...)` in it must be an error rather than something that runs. Lines
# are KEY=VALUE, the value optionally in single or double quotes; only $HOME
# and a leading ~ are expanded. Any key may carry a _<backend> suffix
# (LOGIN_fasrc, DEST_nersc); the suffixed form wins for that backend.
# Environment variables named ARCHIVE_SYNC_* (below) win over both.
CONFIG_KEYS=" REMOTE DEST TRASH RCLONE RCLONE_PASSWORD_COMMAND RCLONE_PASSWORD_FILE \
TRANSPORT LOGIN FALLBACK_LOGIN TRANSFERS CHECKERS CONNECTIONS FILTER FILTER_DIR \
SCAN_PRUNE_PATHS SCAN_PRUNE_NAMES BACKENDS IO_TIMEOUT "

# Only speed up the symlink scan (see "symlink fence" below). An entry that the
# filter file does not also exclude is dropped from the scan, never trusted.
SCAN_PRUNE_PATHS_DEFAULT=".conda .cache .local .local/lib .npm .nvm .vscode-server
    miniconda3 anaconda3 miniforge3 mambaforge"
SCAN_PRUNE_NAMES_DEFAULT="node_modules .venv venv .git __pycache__ .tox
    .ipynb_checkpoints .pytest_cache .mypy_cache"

not_configured() {
    # Exit 3 means "not set up" (archive-sync-cron relies on it). Nothing has
    # been created or contacted by the time this runs.
    cat >&2 <<EOF
archive-sync: not configured (no $(tilde "$CONFIG")).
archive-sync is an optional extra that mirrors a cluster home into an rclone
remote; nothing in \`cluster\` needs it. To set it up, see extras/README.md in
the cluster repository: an rclone remote, then that config file with at least
REMOTE=yourremote: in it.
EOF
    exit 3
}
no_destination() {
    die "no destination for backend '$1' in $(tilde "$CONFIG"): set REMOTE, or DEST_$1"
}

config_error() { echo "archive-sync: $(tilde "$CONFIG"), line $1: $2" >&2; exit 2; }

is_config_key() { case "$CONFIG_KEYS" in *" $1 "*) return 0 ;; esac; return 1; }

load_config() {
    local line key val base suffix q rest after n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        case "$line" in ''|'#'*) continue ;; esac
        line="${line#export }"
        case "$line" in
            [A-Z]*=*) ;;
            *) config_error "$n" "expected KEY=VALUE" ;;
        esac
        key="${line%%=*}"
        key="${key%"${key##*[![:space:]]}"}"
        val="${line#*=}"
        val="${val#"${val%%[![:space:]]*}"}"
        case "$key" in *[!A-Za-z0-9_]*) config_error "$n" "invalid key '$key'" ;; esac
        if ! is_config_key "$key"; then
            base="${key%_*}"; suffix="${key##*_}"
            case "$suffix" in
                ''|*[!a-z0-9]*) config_error "$n" "unknown key '$key'" ;;
            esac
            is_config_key "$base" || config_error "$n" "unknown key '$key'"
        fi
        case "$val" in
            \"*|\'*)
                q="${val:0:1}"; rest="${val:1}"
                case "$rest" in *"$q"*) ;; *) config_error "$n" "unterminated quote" ;; esac
                val="${rest%%"$q"*}"
                after="${rest#*"$q"}"
                after="${after#"${after%%[![:space:]]*}"}"
                case "$after" in
                    ''|'#'*) ;;
                    *) config_error "$n" "unexpected text after the closing quote" ;;
                esac
                ;;
            *)
                q=""
                val="${val%%[[:space:]]#*}"
                val="${val%"${val##*[![:space:]]}"}"
                ;;
        esac
        if [ "$q" != "'" ]; then
            # shellcheck disable=SC2016  # matches a literal $(
            case "$val" in
                *'$('*|*'`'*)
                    config_error "$n" "command substitution is not supported (the file is parsed, not run)" ;;
            esac
            # shellcheck disable=SC2088  # matches a literal ~
            case "$val" in
                '~') val="$HOME" ;;
                '~/'*) val="$HOME/${val#'~/'}" ;;
            esac
            val="${val//\$\{HOME\}/$HOME}"
            val="${val//\$HOME/$HOME}"
            case "$val" in
                *'$'*) config_error "$n" "only \$HOME and a leading ~ are expanded" ;;
            esac
        fi
        printf -v "ASCFG_$key" '%s' "$val"
    done < "$CONFIG"
}

# cfg KEY [DEFAULT]: the backend's own value, else the global one, else DEFAULT.
cfg() {
    local own="ASCFG_${1}_${BACKEND}" all="ASCFG_$1"
    if [ -n "${!own+x}" ]; then printf '%s' "${!own}"
    elif [ -n "${!all+x}" ]; then printf '%s' "${!all}"
    else printf '%s' "${2-}"
    fi
}
cfg_is_set() {
    local own="ASCFG_${1}_${BACKEND}" all="ASCFG_$1"
    [ -n "${!own+x}" ] || [ -n "${!all+x}" ]
}

valid_backend() { case "$1" in ''|[!a-z]*|*[!a-z0-9]*) return 1 ;; esac; return 0; }

# <REMOTE><backend>-home, with a separator only where REMOTE lacks one.
join_remote() {
    case "$1" in
        *:|*/) printf '%s%s' "$1" "$2" ;;
        *) printf '%s/%s' "$1" "$2" ;;
    esac
}

# The destination for $BACKEND, or empty when there is none.
resolve_dest() {
    local remote
    if [ -n "${ARCHIVE_SYNC_DEST:-}" ]; then printf '%s' "$ARCHIVE_SYNC_DEST"; return; fi
    if cfg_is_set DEST && [ -n "$(cfg DEST)" ]; then cfg DEST; return; fi
    remote="$(cfg REMOTE)"
    [ -z "$remote" ] || join_remote "$remote" "${BACKEND}-home"
}

if [ -f "$CONFIG" ]; then
    load_config
elif [ -z "${ARCHIVE_SYNC_DEST:-}" ]; then
    not_configured
fi

# The backends archive-sync-cron mirrors, in order; the first is also the
# default --backend. ARCHIVE_SYNC_BACKENDS, else BACKENDS, else the cluster
# tool's own default backend.
BACKENDS_LIST=""
resolve_backends() {
    local b
    BACKENDS_LIST="${ARCHIVE_SYNC_BACKENDS:-}"
    [ -n "$BACKENDS_LIST" ] || BACKENDS_LIST="$(BACKEND=_ cfg BACKENDS)"
    if [ -z "$BACKENDS_LIST" ]; then
        # `config get` reads local settings only: it never authenticates or
        # opens a connection.
        BACKENDS_LIST="$(cluster config get BACKEND 2>/dev/null || true)"
        valid_backend "$BACKENDS_LIST" || BACKENDS_LIST="fasrc"
    fi
    BACKENDS_LIST="$(printf '%s' "$BACKENDS_LIST" | tr -s '[:space:]' ' ')"
    BACKENDS_LIST="${BACKENDS_LIST# }"; BACKENDS_LIST="${BACKENDS_LIST% }"
    for b in $BACKENDS_LIST; do
        valid_backend "$b" || die "BACKENDS: invalid backend name '$b'"
    done
}

if [ "$MODE" = list ]; then
    resolve_backends
    for b in $BACKENDS_LIST; do
        [ -n "$(BACKEND="$b" resolve_dest)" ] || no_destination "$b"
    done
    printf '%s\n' "$BACKENDS_LIST"
    exit 0
fi

if [ -z "$BACKEND" ]; then
    resolve_backends
    BACKEND="${BACKENDS_LIST%% *}"
fi
valid_backend "$BACKEND" || die "invalid backend name: '$BACKEND'"

# ---- per-backend settings ---------------------------------------------------
DEST="$(resolve_dest)"
[ -n "$DEST" ] || no_destination "$BACKEND"
case "$DEST" in
    *:*|/*) ;;
    # A bare word is a local path to rclone, relative to cron's cwd: a missing
    # colon on REMOTE would quietly archive to this machine's disk.
    *) die "destination '$DEST' is neither an rclone remote (name:path) nor an absolute path" ;;
esac

case "$BACKEND" in
    nersc) TRANSPORT_DEFAULT=transfer ;;
    *) TRANSPORT_DEFAULT=login ;;
esac
TRANSPORT_KIND="$(cfg TRANSPORT "$TRANSPORT_DEFAULT")"
# --login names a login's master to ride, which only the login transport does.
[ -z "$LOGIN" ] || TRANSPORT_KIND=login
case "$TRANSPORT_KIND" in
    login)
        LOGIN="${LOGIN:-$(cfg LOGIN)}"
        # No LOGIN means the backend's default login, as `cluster` resolves it.
        if [ -n "$LOGIN" ]; then TRANSPORT=("$LOGIN"); else TRANSPORT=(); fi
        # 3 + 3 + 1 = 7 exactly: measured ceiling of a shared FASRC master
        # while sshfs is attached (the 8th channel was refused).
        TRANSFERS_DEFAULT="$(cfg TRANSFERS 3)"
        CHECKERS_DEFAULT="$(cfg CHECKERS 3)"
        ;;
    transfer)
        # A dedicated connection, so the full channel budget is ours.
        TRANSPORT=(--transfer)
        TRANSFERS_DEFAULT="$(cfg TRANSFERS 4)"
        CHECKERS_DEFAULT="$(cfg CHECKERS 3)"
        ;;
    *) die "TRANSPORT must be 'login' or 'transfer', not '$TRANSPORT_KIND'" ;;
esac
for v in "$TRANSFERS_DEFAULT" "$CHECKERS_DEFAULT"; do
    case "$v" in ''|*[!0-9]*|0) die "TRANSFERS/CHECKERS must be positive integers, not '$v'" ;; esac
done

SRC=":sftp,shell_type=unix:."
# Derived from DEST: an overridden destination must take its trash with it,
# and --fast-list is only safe while --backup-dir is a sibling of the synced
# tree rather than a path inside it.
TRASH_ROOT="${ARCHIVE_SYNC_TRASH:-$(cfg TRASH "${DEST}-trash")}"
TRASH="$TRASH_ROOT/$(date +%Y%m%d-%H%M%S)"

PASS_FILE="$(cfg RCLONE_PASSWORD_FILE)"
PASS_CMD="$(cfg RCLONE_PASSWORD_COMMAND)"
if [ -n "$PASS_FILE" ] && [ -n "$PASS_CMD" ]; then
    die "set RCLONE_PASSWORD_FILE or RCLONE_PASSWORD_COMMAND, not both"
fi

FALLBACK_LOGIN="${ARCHIVE_SYNC_FALLBACK_LOGIN:-$(cfg FALLBACK_LOGIN "archive-$BACKEND")}"
FENCE="$STATE_DIR/${BACKEND}-symlink-fence.filter"
LOG="$STATE_DIR/sync-${BACKEND}-$(date +%Y%m%d-%H%M%S).log"
STAMP="$STATE_DIR/last-success-$BACKEND"
SCAN_OUT="$STATE_DIR/${BACKEND}-scan.out"
SCAN_ERR="$STATE_DIR/${BACKEND}-scan.err"

TRANSFERS="${ARCHIVE_SYNC_TRANSFERS:-$TRANSFERS_DEFAULT}"
CHECKERS="${ARCHIVE_SYNC_CHECKERS:-$CHECKERS_DEFAULT}"
CONNECTIONS_SET="${ARCHIVE_SYNC_CONNECTIONS:-$(cfg CONNECTIONS)}"
# rclone's --timeout: how long a connection to the destination may go idle
# before rclone gives up on it and tries again. Over the sftp side it does
# nothing (that connection runs through `cluster ssh-command`, whose
# keepalives watch it), so it is the destination's hang detector.
IO_TIMEOUT="${ARCHIVE_SYNC_IO_TIMEOUT:-$(cfg IO_TIMEOUT 2m)}"
case "$IO_TIMEOUT" in
    ''|*[!0-9a-z.]*) die "IO_TIMEOUT is '$IO_TIMEOUT'; rclone takes a duration such as 2m, 90s or 0 (never)" ;;
esac

# ---- filter -----------------------------------------------------------------
# FILTER names the file outright. Otherwise the backend's own
# <FILTER_DIR>/<backend>-home.filter is used when it exists, and the default
# shipped beside this script when it does not.
FILTER_DIR="$(cfg FILTER_DIR)"
[ -n "$FILTER_DIR" ] || FILTER_DIR="$CONFIG_DIR/archive"
OWN_FILTER="$FILTER_DIR/${BACKEND}-home.filter"
if [ -n "$(cfg FILTER)" ]; then
    FILTER="$(cfg FILTER)"; FILTER_FROM=setting
elif [ -f "$OWN_FILTER" ]; then
    FILTER="$OWN_FILTER"; FILTER_FROM=own
else
    FILTER="$SHIPPED_FILTER"; FILTER_FROM=shipped
fi

# Which filter is in use, and for the shipped default, how to change it.
filter_label() {
    tilde "$FILTER"
    [ "$FILTER_FROM" != shipped ] || printf ' (the default shipped with archive-sync)'
}
filter_hint() {
    [ "$FILTER_FROM" != shipped ] ||
        printf 'to change it, copy it to %s and edit the copy' "$(tilde "$OWN_FILTER")"
}

check_filter() {
    [ -f "$FILTER" ] && return 0
    case "$FILTER_FROM" in
        setting) die "filter file missing: $(tilde "$FILTER") (FILTER in $(tilde "$CONFIG"))" ;;
        *) die "no filter for $BACKEND: create $(tilde "$OWN_FILTER")" \
               "(extras/home.filter in the cluster repository is a starting point)" ;;
    esac
}

# ---- rclone -----------------------------------------------------------------
# The sync needs --sftp-ssh, which rclone added in 1.64. Distribution packages
# are often older, so unless a binary is named outright, the official binary's
# usual homes are tried after the one on PATH, and the first new enough wins.
RCLONE_MIN=1.64

# rclone_version BINARY: the MAJOR.MINOR BINARY reports, or nothing.
# --config /dev/null: asking must not create, or ask to unlock, an rclone.conf.
rclone_version() {
    { "$1" version --config /dev/null 2>/dev/null || true; } | awk '
        $1 == "rclone" && $2 ~ /^v[0-9]+\.[0-9]+/ {
            split(substr($2, 2), part, "."); print part[1] "." part[2]; exit
        }'
}

# at_least X.Y MIN: whether version X.Y is MIN or newer.
at_least() {
    local major="${1%%.*}" minor="${1#*.}" min_major="${2%%.*}" min_minor="${2#*.}"
    [ "$major" -gt "$min_major" ] ||
        { [ "$major" -eq "$min_major" ] && [ "$minor" -ge "$min_minor" ]; }
}

# Sets RCLONE and RCLONE_VERSION, or RCLONE_PROBLEM and RCLONE_HINT when there
# is no usable rclone. Returns non-zero in the second case.
resolve_rclone() {
    local named="" from="" candidate path version seen=" "
    local candidates=()
    RCLONE="" RCLONE_VERSION="" RCLONE_PROBLEM="" RCLONE_HINT=""
    if [ -n "${ARCHIVE_SYNC_RCLONE:-}" ]; then
        named="$ARCHIVE_SYNC_RCLONE"; from="ARCHIVE_SYNC_RCLONE"
    elif [ -n "$(cfg RCLONE)" ]; then
        named="$(cfg RCLONE)"; from="RCLONE in $(tilde "$CONFIG")"
    else
        # The core tool's own RCLONE setting, so that one choice serves both.
        # `config get` reads local settings only.
        named="$(cluster --backend "$BACKEND" config get RCLONE 2>/dev/null || true)"
        from="cluster config set RCLONE"
    fi
    if [ -n "$named" ]; then
        candidates=("$named")
    else
        path="$(command -v rclone 2>/dev/null || true)"
        candidates=(${path:+"$path"} /opt/homebrew/bin/rclone /usr/local/bin/rclone)
    fi
    for candidate in "${candidates[@]}"; do
        path="$(command -v "$candidate" 2>/dev/null || true)"
        [ -n "$path" ] || continue
        case "$seen" in *" $path "*) continue ;; esac
        seen="$seen$path "
        version="$(rclone_version "$path")"
        if [ -n "$version" ] && at_least "$version" "$RCLONE_MIN"; then
            RCLONE="$path"; RCLONE_VERSION="$version"
            return 0
        fi
        # The first binary found is the one worth reporting on.
        [ -n "$RCLONE_PROBLEM" ] && continue
        if [ -n "$version" ]; then
            RCLONE_PROBLEM="$path is rclone $version, which is too old (need $RCLONE_MIN or newer)"
        else
            RCLONE_PROBLEM="$path did not report an rclone version (need $RCLONE_MIN or newer)"
        fi
    done
    [ -n "$RCLONE_PROBLEM" ] || RCLONE_PROBLEM="${named:-rclone} not found (need $RCLONE_MIN or newer)"
    case "$from" in
        ARCHIVE_SYNC_*|RCLONE\ in*) RCLONE_HINT="fix $from" ;;
        *) RCLONE_HINT="install the official binary from https://rclone.org/downloads/, or point at one with: cluster config set RCLONE /path/to/rclone" ;;
    esac
    return 1
}

# ---- scan prunes ------------------------------------------------------------
# SCAN_PRUNE_PATHS (home-relative directories) and SCAN_PRUNE_NAMES (directory
# names, anywhere) only speed up the symlink scan. They must stay in step with
# the static filter, or fence coverage develops blind spots: a link inside a
# pruned tree is never examined, so that tree had better not be synced at all.
# So each entry is checked against the filter file — it must be excluded there
# as `- /PATH/**` (or `- NAME/**`) with no include rule above it — and one that
# is not is scanned after all. Globs (* ?) match within one path component, as
# in rclone; find's -path would let * cross a /, so each glob entry is pinned
# to its own depth.
filter_excludes() {  # filter_excludes RULE RULE: either line present, no + or ! above
    awk -v a="$1" -v b="$2" '
        { sub(/^[ \t]+/, ""); sub(/[ \t\r]+$/, "") }
        /^[+!]/ { blocked = 1; exit }
        $0 == a || $0 == b { found = 1; exit }
        END { exit (found && !blocked) ? 0 : 1 }' "$FILTER"
}

PRUNE_EXPR=""
PRUNE_NOTES=()
build_prunes() {
    local paths names p comps depth stars piece explicit_p=0 explicit_n=0
    paths="$(cfg SCAN_PRUNE_PATHS "$SCAN_PRUNE_PATHS_DEFAULT")"
    names="$(cfg SCAN_PRUNE_NAMES "$SCAN_PRUNE_NAMES_DEFAULT")"
    cfg_is_set SCAN_PRUNE_PATHS && explicit_p=1
    cfg_is_set SCAN_PRUNE_NAMES && explicit_n=1
    set -f
    for p in $paths; do
        case "$p" in
            /*|*/|*//*|*'**'*|..|../*|*/..|*/../*|*[!A-Za-z0-9._+@%,=:*?/-]*)
                set +f; die "SCAN_PRUNE_PATHS: unusable entry '$p' (home-relative, no ** or quotes)" ;;
        esac
        if ! filter_excludes "- /$p/**" "- /$p/"; then
            [ "$explicit_p" = 0 ] || PRUNE_NOTES+=("scan prune '$p' is not excluded by $(tilde "$FILTER"); scanning it")
            continue
        fi
        case "$p" in
            *[*?]*)
                comps="${p//[!\/]/}"; depth=$(( ${#comps} + 1 ))
                stars="*"
                while [ "$depth" -gt 0 ]; do stars="$stars/*"; depth=$((depth - 1)); done
                piece="\\( -path \"\$H/$p\" ! -path \"\$H/$stars\" \\)"
                ;;
            *) piece="-path \"\$H/$p\"" ;;
        esac
        PRUNE_EXPR="${PRUNE_EXPR:+$PRUNE_EXPR -o }$piece"
    done
    for p in $names; do
        case "$p" in
            */*|*[!A-Za-z0-9._+@%,=:*?-]*)
                set +f; die "SCAN_PRUNE_NAMES: unusable entry '$p' (a bare directory name)" ;;
        esac
        if ! filter_excludes "- $p/**" "- $p/"; then
            [ "$explicit_n" = 0 ] || PRUNE_NOTES+=("scan prune '$p' is not excluded by $(tilde "$FILTER"); scanning it")
            continue
        fi
        case "$p" in
            *[*?]*) piece="-name \"$p\"" ;;
            *) piece="-name $p" ;;
        esac
        PRUNE_EXPR="${PRUNE_EXPR:+$PRUNE_EXPR -o }$piece"
    done
    set +f
}

# ---- --show-config ----------------------------------------------------------
if [ "$MODE" = show ]; then
    present() { [ -e "$1" ] && echo "present" || echo "MISSING"; }
    echo "config:       $(tilde "$CONFIG") ($(present "$CONFIG"))"
    [ -n "$BACKENDS_LIST" ] || resolve_backends
    echo "backend:      $BACKEND   (archive-sync-cron mirrors: $BACKENDS_LIST)"
    echo "destination:  $DEST"
    echo "trash:        $TRASH_ROOT/<timestamp>/"
    if resolve_rclone; then
        echo "rclone:       $RCLONE (rclone $RCLONE_VERSION; $RCLONE_MIN or newer is needed)"
    else
        echo "rclone:       PROBLEM: $RCLONE_PROBLEM"
        echo "              $RCLONE_HINT"
    fi
    if [ -n "$PASS_FILE" ]; then
        echo "rclone.conf:  password read from $(tilde "$PASS_FILE") ($(present "$PASS_FILE"))"
    elif [ -n "$PASS_CMD" ]; then
        echo "rclone.conf:  password from RCLONE_PASSWORD_COMMAND (set)"
    else
        echo "rclone.conf:  no password command configured"
    fi
    if [ "$TRANSPORT_KIND" = transfer ]; then
        echo "transport:    dedicated transfer connection"
    else
        echo "transport:    login '${TRANSPORT[0]-(the backend default)}', fallback '$FALLBACK_LOGIN'"
    fi
    if [ "$TRANSPORT_KIND" = transfer ]; then
        echo "concurrency:  $TRANSFERS transfers + $CHECKERS checkers"
    else
        echo "concurrency:  $TRANSFERS transfers + $CHECKERS checkers (before channel fitting)"
    fi
    echo "idle limit:   $IO_TIMEOUT (rclone --timeout, on the destination's connections)"
    if [ "$FILTER_FROM" = shipped ]; then
        echo "filter:       $(tilde "$FILTER") ($(present "$FILTER"), the default shipped with archive-sync)"
        echo "              $(filter_hint)"
    else
        echo "filter:       $(tilde "$FILTER") ($(present "$FILTER"))"
    fi
    if [ -f "$FILTER" ]; then
        build_prunes
        for note in ${PRUNE_NOTES[@]+"${PRUNE_NOTES[@]}"}; do echo "note:         $note"; done
        echo "scan prunes:  ${PRUNE_EXPR:-(none)}"
    fi
    echo "state:        $(tilde "$STATE_DIR")"
    exit 0
fi

# ---- local checks, before anything is contacted -----------------------------
# Everything here would fail the same way on every retry, so it exits 2, and it
# runs before the cluster is asked for a connection: a mistake in the config
# must not cost a credential.
check_filter
command -v cluster >/dev/null 2>&1 ||
    die "\`cluster\` is not on PATH: it provides the connection (add its directory to PATH)"
command -v python3 >/dev/null 2>&1 || die "python3 is not on PATH: it builds the symlink fence"
if [ "$FENCE_ONLY" = 0 ]; then
    resolve_rclone || die "$RCLONE_PROBLEM; $RCLONE_HINT"
    if [ -n "$PASS_FILE" ]; then
        [ -f "$PASS_FILE" ] || die "rclone.conf password file missing: $(tilde "$PASS_FILE")" \
                                   "(RCLONE_PASSWORD_FILE in $(tilde "$CONFIG"))"
        if [ -n "$(find "$PASS_FILE" -prune \( -perm -004 -o -perm -040 \) -print 2>/dev/null)" ]; then
            echo "note: $(tilde "$PASS_FILE") is readable by other users; chmod 600 it"
        fi
    fi
fi
build_prunes

# The per-run logs list every file name in the home, so the state directory is
# the user's alone.
(umask 077 && mkdir -p "$STATE_DIR")
for note in ${PRUNE_NOTES[@]+"${PRUNE_NOTES[@]}"}; do echo "note: $note"; done

# lock_fd FD: take an exclusive lock on open descriptor FD without waiting.
# Returns 0 once it is held, 1 when another process holds it, 2 when it cannot
# be tried. flock(1) is util-linux, so where it is missing (macOS) python3 takes
# the same flock(2) lock on the inherited descriptor; the lock belongs to the
# open file description, which this shell keeps open, so it outlives python3.
lock_fd() {
    local rc=0
    if command -v flock >/dev/null 2>&1; then
        flock -n "$1" || rc=$?
    else
        python3 -c '
import errno, fcntl, sys
try:
    fcntl.flock(int(sys.argv[1]), fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError as exc:
    sys.exit(1 if exc.errno in (errno.EAGAIN, errno.EACCES) else 2)
' "$1" 2>/dev/null || rc=$?
    fi
    case "$rc" in
        0|1) return "$rc" ;;
        *) return 2 ;;
    esac
}

# One sync per backend at a time; different backends may run concurrently.
exec 9>"$STATE_DIR/$BACKEND.lock"
lock_rc=0
lock_fd 9 || lock_rc=$?
case "$lock_rc" in
    0) ;;
    1) echo "archive-sync: another archive-sync ($BACKEND) is already running" >&2; exit 4 ;;
    *) die "cannot lock $(tilde "$STATE_DIR/$BACKEND.lock"): it needs flock(1) or python3" ;;
esac

# ---- transport ------------------------------------------------------------
# Brings the connection up (re-authenticating if it must) and hands back an ssh
# command line for rclone. Everything transport-specific stops here.
#
# Getting a command line back is not the same as having a usable transport.
# Two ways a shared login master is up yet useless:
#   * its channels are spent: every open `cluster attach` holds one, and rclone
#     needs transfers + checkers + 1.
#   * its node accepts connections but refuses per-user exec while still
#     passing the balancer's health check, so the master comes up and the
#     symlink scan fails.
# Both have the answer `cluster bridge push --cron` gives: a node that refuses
# sessions must not strand an unattended job. Stop riding somebody else's
# master and open a login of our own — full channel budget, and a different
# node. That costs one credential (a TOTP window on FASRC) on the nights it is
# needed, which buys the day's archive; skipping the day costs the archive and
# says nothing.
OWN_LOGIN=""            # a login we opened, and must therefore close
OWN_XFER_TAG=""         # a transfer connection we opened, likewise
FALLBACKS_LEFT=2        # our own login, then one move to a fresh node

transport_label() {
    if [ "${TRANSPORT[0]-}" = "--transfer" ]; then
        echo "the $BACKEND transfer connection"
    elif [ -n "${TRANSPORT[0]-}" ]; then
        echo "login '${TRANSPORT[0]}'"
    else
        echo "the default $BACKEND login"
    fi
}

release_transport() {
    # Ours to close: a transfer connection or a login this run opened itself.
    # One that was already there belongs to whoever made it.
    if [ -n "$OWN_XFER_TAG" ]; then
        cluster --backend "$BACKEND" transfer --close "$OWN_XFER_TAG" >/dev/null 2>&1 || true
    fi
    if [ -n "$OWN_LOGIN" ]; then
        echo "closing the '$OWN_LOGIN' login opened for this run"
        cluster --backend "$BACKEND" close "$OWN_LOGIN" >/dev/null 2>&1 || true
    fi
    rm -f "$SCAN_OUT" "$SCAN_ERR" "$FENCE.tmp" "$STATE_DIR/$BACKEND-transport.said"
}
# Installed before the first connection is asked for, so no way out of this
# script leaves one behind; a signal becomes an exit, which runs the trap.
trap release_transport EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

open_transport() {
    local said="$STATE_DIR/$BACKEND-transport.said" tag rc=0
    # cluster prints the command line on stdout. What it says on stderr is
    # shown as it comes, and kept: that is where it names the transfer
    # connection, and says whether it opened it or found it open. It is read
    # even when the command fails, since a connection it opened is ours to
    # close either way.
    SSH_CMD="$( { cluster --backend "$BACKEND" ssh-command ${TRANSPORT[@]+"${TRANSPORT[@]}"} \
                  2>&1 1>&3 3>&- | tee "$said" >&2; } 3>&1 )" || rc=$?
    if [ "${TRANSPORT[0]-}" = "--transfer" ]; then
        tag="$(sed -n 's/.*opened transfer connection \([^ ]*\).*/\1/p' "$said" | tail -n 1)"
        if [ -n "$tag" ]; then
            OWN_XFER_TAG="$tag"
        elif [ "$rc" = 0 ] && ! grep -q 'reusing transfer connection' "$said"; then
            echo "note: cluster did not say which transfer connection this is, so it is left open"
        fi
    fi
    rm -f "$said"
    return "$rc"
}

echo "asking cluster for a $BACKEND transport ..."
open_transport || fail "could not obtain a $BACKEND connection"

remote_ssh() { eval "$SSH_CMD" '"$@"'; }

# The same command for rclone's --sftp-ssh, which does not read shell words:
# it splits its value as one CSV record with spaces for commas, so a word
# holding a space or a double quote is double-quoted there, with "" for a
# quote. Shell quoting would break on any path with a space in it. The words
# are the ones the shell reads out of SSH_CMD, as remote_ssh runs them. They
# are converted here rather than asked of `cluster ssh-command --rclone`: a
# second call would take the connection again, and if it had dropped in
# between, could open one this run does not know it owns.
rclone_ssh_value() {
    local q='"' word value="" sep=""
    eval "set -- $SSH_CMD"
    for word; do
        case "$word" in
            ""|*[[:space:]]*|*\"*) word="$q${word//$q/$q$q}$q" ;;
        esac
        value="$value$sep$word"
        sep=" "
    done
    printf '%s\n' "$value"
}

# One rung up the ladder: primary -> a login of our own -> that login on a
# fresh node. Returns non-zero when there is no rung left, which is the
# caller's cue to give up with its own diagnosis.
escalate_transport() {
    local why="$1"
    if [ "${TRANSPORT[0]-}" = "--transfer" ]; then
        # A dedicated connection already has the whole channel budget and a
        # node meant for I/O, so neither failure this ladder handles applies.
        return 1
    fi
    if [ "$FALLBACKS_LEFT" -le 0 ]; then
        return 1
    fi
    FALLBACKS_LEFT=$((FALLBACKS_LEFT - 1))
    if [ -z "$OWN_LOGIN" ]; then
        if [ "${TRANSPORT[0]-}" = "$FALLBACK_LOGIN" ]; then
            return 1    # we were asked to ride the fallback name itself
        fi
        # `cluster channels` reads local state only — no channel, no
        # credential — so this answers "does that login already exist?" for
        # free. One that somebody else opened is not ours to close afterwards,
        # and not ours to move either.
        if cluster --backend "$BACKEND" channels "$FALLBACK_LOGIN" --free \
                >/dev/null 2>&1; then
            echo "$why — switching to the existing '$FALLBACK_LOGIN' login"
        else
            echo "$why — opening a '$FALLBACK_LOGIN' login of our own"
            OWN_LOGIN="$FALLBACK_LOGIN"
        fi
        TRANSPORT=("$FALLBACK_LOGIN")
    else
        echo "$why — moving '$OWN_LOGIN' to a fresh node"
        cluster --backend "$BACKEND" refresh "$OWN_LOGIN" >/dev/null 2>&1 || true
    fi
    if ! open_transport; then
        echo "could not obtain a $BACKEND connection via $(transport_label)" >&2
        return 1
    fi
    # A connection of our own starts from the measured defaults again: the
    # scaling below exists only because a shared master's budget is shared.
    TRANSFERS="${ARCHIVE_SYNC_TRANSFERS:-$TRANSFERS_DEFAULT}"
    CHECKERS="${ARCHIVE_SYNC_CHECKERS:-$CHECKERS_DEFAULT}"
    return 0
}

# ---- fit the concurrency to the channels actually free ---------------------
# Asked *after* the transport exists, so the count reflects the connection rclone
# will really use.
#
# A dedicated transfer connection is ours alone, so the full budget applies.
# Riding a login's master (because a connection of its own costs a fresh
# credential — which the ladder above spends only once the shared master has
# actually turned out to be unusable) means SHARING sshd's ten channels with
# everything else on that login. The 3+3+1=7 default fits a master with sshfs
# attached and nothing else. Every open `cluster attach` holds one more channel
# for as long as it stays open, so a fixed count overruns sshd's ten channels
# once a few attaches are open.
#
# So ask instead of assuming. `cluster channels --free` reads local process state
# only — no channel spent, no authentication — and is a floor rather than a
# guarantee, which is the right side to err on.
CHANNEL_SHORTFALL=""

fit_concurrency() {
    [ "${TRANSPORT[0]-}" != "--transfer" ] || return 0
    local free usable
    free="$(cluster --backend "$BACKEND" channels ${TRANSPORT[@]+"${TRANSPORT[@]}"} --free 2>/dev/null || true)"
    case "$free" in
        ''|*[!0-9]*)
            echo "note: could not read the free channel count; keeping $TRANSFERS transfers + $CHECKERS checkers"
            return 0
            ;;
    esac
    # Reserve one channel for rclone's own hash/mkdir shell commands, and leave
    # one spare so an interactive `cluster` command can still get in while the
    # sync runs.
    usable=$((free - 2))
    if [ "$usable" -lt 2 ]; then
        CHANNEL_SHORTFALL="only $free channel(s) free on '${TRANSPORT[0]:-the default login}'"
        return 1
    fi
    if [ $((TRANSFERS + CHECKERS)) -gt "$usable" ]; then
        # Favour checkers when splitting what is left: this mirrors a
        # mostly-unchanged tree, so it is overwhelmingly a checking workload
        # and the transfer slots sit idle.
        CHECKERS=$(( (usable + 1) / 2 ))
        TRANSFERS=$(( usable - CHECKERS ))
        if [ "$TRANSFERS" -lt 1 ]; then
            TRANSFERS=1
            CHECKERS=$((usable - 1))
        fi
        echo "scaling down to $TRANSFERS transfers + $CHECKERS checkers:" \
             "only $free of the connection's channels are free"
    fi
    return 0
}

while ! fit_concurrency; do
    escalate_transport "$CHANNEL_SHORTFALL" || {
        echo "refusing to start: $CHANNEL_SHORTFALL, and no connection of our" \
             "own is available — syncing now would starve everything else" >&2
        echo "close an attach you are not using, then check:" \
             "cluster --backend $BACKEND channels ${TRANSPORT[0]-}" >&2
        exit 1
    }
done

CONNECTIONS="${CONNECTIONS_SET:-$((TRANSFERS + CHECKERS + 1))}"

# ---- symlink fence + .nosync markers -------------------------------------
# List every symlink outside the statically-excluded trees and exclude every one
# whose target escapes the home directory, read either as written or with the
# other links the scan found followed on the way. Emits both `- /path` and
# `- /path/**` since the link may point at a file or a directory.
#
# The same scan collects `.nosync` markers and turns each into an exclude rule
# for its directory — see the --exclude-if-present note at the top.
#
# The remote side prints NUL-terminated fields, three to a record, so no file
# name can break the framing: `L PATH TARGET` per symlink, `N DIR ''` per
# .nosync marker, then `R STATUS ''` with find's exit status and `H HOME ''`
# with the home it scanned. The status is not decoration: a `find` that dies
# on a bad expression or an unreadable directory still leaves the remote
# command succeeding, and an empty fence from a failed scan would let the sync
# follow every external symlink straight into scratch. The fence is written
# only from a scan that reports status 0.
#
# The scan walks the *resolved* home. On NERSC $HOME is /global/homes/<i>/<user>,
# which is itself a symlink to /global/u2/...; scanning it by that name makes
# find report the home directory as an external symlink and fences the entire
# tree ("- /**"), which silently archives nothing. rclone syncs the login
# shell's cwd, which is the resolved path, so resolving here also makes the two
# agree. The prunes are written against the resolved home ($H) for the same
# reason: against $HOME they never match there, and the scan walks every pruned
# tree anyway.
echo "filter: $(filter_label)"
[ "$FILTER_FROM" != shipped ] || echo "  $(filter_hint)"
echo "scanning $BACKEND home for symlinks that escape it ..."
scan_home() {
    local prune=""
    [ -z "$PRUNE_EXPR" ] || prune="\\( $PRUNE_EXPR \\) -prune -o "
    remote_ssh "H=\$(cd \"\$HOME\" && pwd -P); \
find \"\$H\" ${prune}-type l -printf 'L\\0%p\\0%l\\0' -o -name .nosync -printf 'N\\0%h\\0\\0'; \
printf 'R\\0%s\\0\\0H\\0%s\\0\\0' \"\$?\" \"\$H\"" >"$SCAN_OUT" 2>"$SCAN_ERR"
}

# What the remote said, which is the whole difference between "the node refused
# to exec", "the connection died" and "a directory could not be read".
show_scan_err() {
    local lines
    lines="$(wc -l 2>/dev/null < "$SCAN_ERR" || echo 0)"
    sed -n '1,20s/^/  scan: /p' "$SCAN_ERR" >&2 2>/dev/null || true
    [ "$lines" -le 20 ] || echo "  scan: ... $((lines - 20)) more line(s)" >&2
}

while ! scan_home; do
    show_scan_err
    escalate_transport "the symlink scan could not run on $(transport_label)" || {
        echo "symlink scan failed on $(transport_label)" \
             "— refusing to sync unfenced" >&2
        exit 1
    }
done

if ! python3 - "$SCAN_OUT" > "$FENCE.tmp" <<'EOF'
import os.path
import sys

META = frozenset("\\*?[]{}")


def refuse(why):
    sys.exit("refusing to write a fence: " + why)


def text(raw):
    # Remote names are bytes. Undecodable ones survive as lone surrogates,
    # which rule() turns into wildcards.
    return raw.decode("utf-8", "surrogateescape")


def rule(rel):
    """rel as an rclone filter pattern: glob characters escaped, and anything
    a filter line cannot carry as itself turned into "?", which matches any
    one character. That can also exclude a sibling differing only there,
    never less than the path itself."""
    out = []
    for ch in rel:
        if ch in META:
            out.append("\\" + ch)
        elif ord(ch) < 32 or ord(ch) == 127 or "\udc80" <= ch <= "\udcff":
            # A control character (a newline ends the line) or a byte that
            # is not UTF-8.
            out.append("?")
        else:
            out.append(ch)
    # rclone strips whitespace from both ends of every filter line, so
    # trailing whitespace in a name would silently vanish from the rule.
    end = len(rel)
    while end and rel[end - 1].isspace():
        end -= 1
        out[end] = "?"
    return "".join(out)


with open(sys.argv[1], "rb") as handle:
    fields = handle.read().split(b"\0")
if fields[-1] != b"" or (len(fields) - 1) % 3:
    refuse("the scan output is cut short or malformed")
records = [fields[i:i + 3] for i in range(0, len(fields) - 1, 3)]
if len(records) < 2 or records[-2][0] != b"R" or records[-1][0] != b"H":
    refuse("the scan did not report its end")
status = records[-2][1].decode("ascii", "replace")
home = text(records[-1][1]).rstrip("/")
if not home:
    refuse("could not determine the remote home")
if status != "0":
    # An empty fence is not a safe default: it means "follow every symlink".
    refuse("the remote find exited %s (the sync would follow external "
           "symlinks)" % status)


def inside(path):
    return path is not None and (path == home or path.startswith(home + "/"))


entries = []
links = {}
for kind, path, target in records[:-2]:
    if kind not in (b"L", b"N"):
        refuse("the scan output holds an unknown record")
    path = text(path)
    if not inside(path):
        refuse("the scan reported a path outside the home: %r" % path)
    entries.append((kind, path, text(target)))
    if kind == b"L":
        links[path] = text(target)


def followed(path):
    """Where *path* leads once every link the scan saw is followed, as the
    server will; None for a loop. A link in a pruned tree, or outside the
    home, is not known here, and its path is taken as it stands."""
    done = ""
    todo = path.split("/")[1:]
    hops = 0
    while todo:
        part = todo.pop(0)
        if part in ("", "."):
            continue
        if part == "..":
            done = done.rsplit("/", 1)[0]
            continue
        step = done + "/" + part
        if step in links:
            hops += 1
            if hops > 40:
                return None
            target = links[step]
            if target.startswith("/"):
                done = ""
            todo = target.split("/") + todo
            continue
        done = step
    return done or "/"


fenced = 0
nosync = 0
out = ["# auto-generated by archive-sync: symlinks whose targets resolve",
       "# outside the cluster home directory, plus directories holding a",
       "# .nosync marker. Regenerated on every run."]
for kind, path, target in entries:
    rel = path[len(home):]  # keeps the leading /
    if kind == b"N":
        # .nosync marker: exclude the directory holding it, and its contents.
        if not rel:  # a marker in the home itself would exclude everything
            print("refusing to honour .nosync in the home root", file=sys.stderr)
            continue
        out.append("- " + rule(rel))
        out.append("- " + rule(rel) + "/**")
        nosync += 1
        continue
    # Inside only if both readings agree: the target as written, and the
    # target with the links it passes through followed (hop -> /scratch
    # takes data -> hop/x out of the home as well).
    absolute = target if target.startswith("/") \
        else os.path.join(os.path.dirname(path), target)
    if inside(os.path.normpath(absolute)) and inside(followed(path)):
        continue
    if not rel:
        # The home itself came back as a symlink. A rule for it would be
        # "- /**" and exclude the entire tree; the scan resolves the home
        # first, so this means the remote side is not doing what it should.
        print("refusing to fence the home directory itself", file=sys.stderr)
        continue
    out.append("- " + rule(rel))
    out.append("- " + rule(rel) + "/**")
    fenced += 1
sys.stdout.buffer.write(("\n".join(out) + "\n").encode("utf-8"))
print("fenced %d external symlinks, %d .nosync directories" % (fenced, nosync),
      file=sys.stderr)
EOF
then
    show_scan_err
    if grep -q 'Permission denied' "$SCAN_ERR" 2>/dev/null; then
        echo "a directory the scan cannot read cannot be fenced: fix its" \
             "permissions, or exclude it in the filter and add it to" \
             "SCAN_PRUNE_PATHS (which replaces the default list)" >&2
    fi
    echo "no fence written — refusing to sync unfenced" >&2
    exit 1
fi
mv "$FENCE.tmp" "$FENCE"

if [ "$FENCE_ONLY" = 1 ]; then
    echo "fence written to $(tilde "$FENCE")"
    exit 0
fi
# --------------------------------------------------------------------------

# An encrypted rclone.conf is unlocked through RCLONE_PASSWORD_COMMAND: rclone
# runs the command and reads the password from its stdout, so the password is
# never in argv or the environment. RCLONE_PASSWORD_FILE is the common case
# (a mode-600 file, read with cat). rclone splits the command line the way a
# CSV line is split, on spaces: a double-quoted field keeps its spaces, and ""
# inside one stands for a quote. So the path is always quoted that way.
if [ -n "$PASS_FILE" ]; then
    q='"'
    export RCLONE_PASSWORD_COMMAND="/bin/cat $q${PASS_FILE//$q/$q$q}$q"
elif [ -n "$PASS_CMD" ]; then
    export RCLONE_PASSWORD_COMMAND="$PASS_CMD"
fi

echo "syncing $BACKEND home -> $DEST (rclone $RCLONE_VERSION, log: $(tilde "$LOG"))"
rclone_rc=0
"$RCLONE" sync "$SRC" "$DEST" \
    --sftp-ssh "$(rclone_ssh_value)" \
    --filter-from "$FENCE" \
    --filter-from "$FILTER" \
    --backup-dir "$TRASH" \
    --fast-list \
    --transfers "$TRANSFERS" --checkers "$CHECKERS" \
    --sftp-connections "$CONNECTIONS" \
    --multi-thread-streams 1 \
    --timeout "$IO_TIMEOUT" \
    --modify-window 2s \
    --log-file "$LOG" --log-level INFO \
    --progress \
    ${ARGS[@]+"${ARGS[@]}"} || rclone_rc=$?
if [ "$rclone_rc" -ne 0 ]; then
    echo "archive-sync: rclone exited $rclone_rc; see $(tilde "$LOG")" >&2
    # rclone's 2 is a syntax or usage error (a bad flag or flag value): the
    # same command would fail the same way tomorrow. Its 1 is any error not
    # otherwise categorised, which includes failing to reach the server at
    # all, so that one is left for a retry.
    [ "$rclone_rc" -ne 2 ] || exit 2
    exit 1
fi

# A stamp per backend, so "when did this last actually work?" is answerable
# without reading the logs; archive-sync-cron warns when one goes stale. A dry
# run archives nothing, so it does not reset the stamp.
case " ${ARGS[*]-} " in
    *" --dry-run "*|*" --dry-run=true "*) DRY_RUN=1 ;;
esac
if [ "$DRY_RUN" = 0 ]; then
    date +%s > "$STAMP.tmp" && mv "$STAMP.tmp" "$STAMP"
fi

if [ "$DRY_RUN" = 1 ]; then
    echo "done (dry run: nothing was changed; the report is in $(tilde "$LOG"))"
else
    echo "done. deleted/overwritten files (if any) were kept under: $TRASH"
fi
